@page "/playlist/{PlaylistId:int}/edit"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using WebMusicPlayer.Data.Models

@inject IMusicService MusicService
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

@if (isLoading)
{
    <div class="text-muted" style="padding: 40px; text-align: center;">Загрузка...</div>
}
else if (playlist == null || !hasAccess)
{
    <div class="text-muted" style="color: var (--accent); padding: 40px; text-align: center;">
        <p style="color: #ffffff; font-size: 18px; font-weight: 600; margin: 0 0 10px 0;">
        @(playlist == null ? "Плейлист не найден" : "Доступ запрещён.")<br />
        </p>
        <a href="/playlists" style="color: var(--accent);">← Вернуться к плейлистам</a>
    </div>
}
else
{
    <div class="section">
        <h3 class="section-title">Редактирование: @playlist.Name</h3>

        <!-- Форма метаданных -->
        <div class="form-group">
            <label>Название</label>
            <input @bind="editName" class="form-control" />
        </div>
        <div class="form-group">
            <label class="public-toggle">
                <input type="checkbox" @bind="editIsPublic" class="toggle-checkbox" />
                <span class="toggle-label">Публичный</span>
            </label>
        </div>
        <div class="form-group">
            <label>Обложка</label>
            <InputFile OnChange="OnCoverSelected" accept="image/*" class="form-control" />
        </div>

        <!-- БЛОК ДОБАВЛЕНИЯ ТРЕКОВ -->
        <div class="form-group" style="margin-top: 30px; border-top: 1px solid var(--border); padding-top: 20px;">
            <label>Добавить треки в плейлист</label>
            <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                <input @bind="trackSearchQuery" @onkeydown="OnTrackSearchKeyDown" placeholder="Поиск трека..." class="form-control" style="flex: 1;" />

                <select class="form-control" style="width: 150px;"
                        value="@(selectedGenreId?.ToString() ?? "")"
                        @onchange="OnGenreFilterChanged">
                    <option value="">Все жанры</option>
                    @foreach (var g in availableGenres)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>

                <button @onclick="SearchTracksAsync" class="btn btn-outline">🔍</button>
            </div>

            @if (searchResults != null && searchResults.Any())
            {
                <div style="max-height: 200px; overflow-y: auto; border: 1px solid var(--border); border-radius: 4px;">
                    @foreach (var t in searchResults)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid #222;">
                            <span style="font-size: 13px;">@t.Title - @t.Artist</span>
                            <button @onclick="() => AddTrackToPlaylist(t.Id)" class="btn btn-primary" style="padding: 4px 8px; font-size: 11px;">+ Добавить</button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Список текущих треков -->
        <div class="form-group" style="margin-top: 20px;">
            <label>Треки в плейлисте (@tracks.Count)</label>
            @if (tracks.Any())
            {
                <div class="track-list-modal" style="max-height: 200px;">
                    @foreach (var track in tracks)
                    {
                        <div class="track-item-modal">
                            <img src="@(track.CoverPath ?? "/images/default-cover.png")" />
                            <div class="track-info">
                                <div class="track-name">@track.Title</div>
                                <div class="artist-name">@track.Artist</div>
                            </div>
                            <button @onclick="() => RemoveTrack(track.Id)" class="btn-remove-track" title="Удалить трек">✕</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding: 10px; color: var(--text-dim);">Пусто</div>
            }
        </div>

        <!-- Кнопки действий -->
        <div class="form-actions" style="margin-top: 24px; display: flex; gap: 12px;">
            <button @onclick="SaveChanges" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "Сохранение..." : "Сохранить")
            </button>
            <button @onclick="ConfirmDelete" class="btn btn-danger">Удалить плейлист</button>
            <a href="/playlist/@PlaylistId" class="btn btn-secondary">Отмена</a>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-error" : "alert-success")" style="margin-top: 16px;">@message</div>
        }
    </div>
}

<!-- Модальное окно подтверждения удаления -->
@if (showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-content" @onclick:stopPropagation>
            <h4 style="color: #f44336; margin-bottom: 16px;">Удалить плейлист?</h4>
            <p style="color: var(--text-dim); margin-bottom: 24px;">
                Вы действительно хотите удалить плейлист <b>"@playlist?.Name"</b>?<br />
                <small>Треки не будут удалены из библиотеки.</small>
            </p>
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button @onclick="CancelDelete" class="btn btn-secondary">Отмена</button>
                <button @onclick="ExecuteDelete" class="btn btn-danger">Да, удалить</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int PlaylistId { get; set; }

    private int? selectedGenreId;
    private List<WebMusicPlayer.Data.Models.Genre> availableGenres = new();

    private bool isAdmin = false;
    private Playlist? playlist;
    private List<Track> tracks = new();
    private bool isLoading = true;
    private bool hasAccess = false;

    private string editName = "";
    private bool editIsPublic = false;
    private IBrowserFile? newCoverFile;

    private bool isSaving = false;
    private string? message;
    private bool isError = false;
    private bool showDeleteConfirm = false;

    private string trackSearchQuery = "";
    private List<Track>? searchResults;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            isAdmin = auth.User.IsInRole("Admin");

            var userIdClaim = auth.User.FindFirst("UserId");
            int userId = userIdClaim != null ? int.Parse(userIdClaim.Value) : 0;

            playlist = await MusicService.GetPlaylistByIdAsync(PlaylistId);
            if (playlist == null) return;

            hasAccess = playlist.OwnerId == userId || (playlist.IsSystem && isAdmin);
            if (!hasAccess) return;

            tracks = await MusicService.GetPlaylistTracksAsync(PlaylistId);
            availableGenres = await MusicService.GetAllGenresAsync();
            StateHasChanged();
            editName = playlist.Name;
            editIsPublic = playlist.IsPublic;
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
        }
        finally { isLoading = false; }
    }

    private async Task SearchTracksAsync()
    {
        List<Track> allFound;

        if (string.IsNullOrWhiteSpace(trackSearchQuery))
        {
            allFound = await MusicService.GetAllTracksAsync();
        }
        else
        {
            allFound = await MusicService.SearchTracksAsync(trackSearchQuery);
        }

        if (selectedGenreId.HasValue)
        {
            allFound = allFound.Where(t => t.GenreId == selectedGenreId.Value).ToList();
        }

        searchResults = allFound;
        StateHasChanged();
    }

    private void OnTrackSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = SearchTracksAsync();
    }

    private async Task AddTrackToPlaylist(int trackId)
    {
        var success = await MusicService.AddTrackToPlaylistAsync(PlaylistId, trackId);
        if (success)
        {
            tracks = await MusicService.GetPlaylistTracksAsync(PlaylistId);
            StateHasChanged();
        }
    }

    private Task OnCoverSelected(InputFileChangeEventArgs e)
    {
        newCoverFile = e.File;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RemoveTrack(int trackId)
    {
        await MusicService.RemoveTrackFromPlaylistAsync(PlaylistId, trackId);
        tracks = await MusicService.GetPlaylistTracksAsync(PlaylistId);
        StateHasChanged();
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        message = null;
        StateHasChanged();

        try
        {
            string? coverPathDb = playlist!.CoverPath;
            if (newCoverFile != null)
            {
                var folder = Path.Combine(Environment.WebRootPath, "covers");
                if (!Directory.Exists(folder)) Directory.CreateDirectory(folder);
                var fileName = $"{Guid.NewGuid()}{Path.GetExtension(newCoverFile.Name)}";
                using var stream = new FileStream(Path.Combine(folder, fileName), FileMode.Create);
                await newCoverFile.OpenReadStream().CopyToAsync(stream);
                coverPathDb = $"/covers/{fileName}";
            }

            var auth = await AuthState.GetAuthenticationStateAsync();
            int userId = int.Parse(auth.User.FindFirst("UserId")!.Value);

            var success = await MusicService.UpdatePlaylistAsync(PlaylistId, userId, editName.Trim(), editIsPublic, coverPathDb, isAdmin);

            if (success)
            {
                message = "Изменения сохранены";
                playlist!.Name = editName;
                playlist.IsPublic = editIsPublic;
                playlist.CoverPath = coverPathDb;
            }
            else
            {
                isError = true;
                message = "Не удалось сохранить изменения";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ConfirmDelete()
    {
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        StateHasChanged();
    }

    private async Task ExecuteDelete()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        int userId = int.Parse(auth.User.FindFirst("UserId")!.Value);
        await MusicService.DeletePlaylistAsync(userId, PlaylistId, isAdmin);
        Navigation.NavigateTo("/playlists");
    }

    private async Task OnGenreFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        selectedGenreId = string.IsNullOrEmpty(val) ? null : int.Parse(val);

        await SearchTracksAsync();
    }
}